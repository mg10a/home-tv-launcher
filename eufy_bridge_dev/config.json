{
  "name": "Eufy Bridge DEV - HEVC Recovery",
  "version": "0.8.39-dev.11",
  "slug": "eufy_bridge_dev",
  "description": "Preserves doorbell shadow detail for automatic dashboard night view. Original recordings remain unchanged; disable preserve_shadow_detail to restore previous decoding.",
  "url": "https://github.com/mg10a/home-tv-launcher",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "application",
  "boot": "manual",
  "init": false,
  "host_network": true,
  "timeout": 20,
  "options": {
    "token": "",
    "diagnostics": true,
    "preserve_shadow_detail": true
  },
  "schema": {
    "token": "password",
    "backend": "str?",
    "diagnostics": "bool?",
    "live_max_bitrate": "str?",
    "live_max_streams_per_station": "int(1,4)?",
    "live_max_seconds_mains": "int(120,3600)?",
    "experimental_standalone": "bool?",
    "standalone_recording_probe": "bool?",
    "preserve_shadow_detail": "bool?"
  },
  "stage": "experimental"
}
